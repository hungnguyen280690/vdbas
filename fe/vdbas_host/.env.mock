# Mock mode — tất cả API và auth đều đi qua mock server
VITE_MOCK_AUTH=true
VITE_API_BASE_URL=http://localhost:9090/api

# Keycloak không dùng ở mock mode (giá trị giữ nguyên để tránh lỗi parse)
VITE_KEYCLOAK_URL=http://localhost:9090
VITE_KEYCLOAK_REALM=mock
VITE_KEYCLOAK_CLIENT_ID=mock

# Remote app URLs
VITE_QTDC_REMOTE_URL=http://localhost:3002
VITE_TEMPLATE_REMOTE_URL=http://localhost:3001
